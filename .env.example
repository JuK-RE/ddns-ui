# Pra onde o proxy /api do Vite repassa as chamadas no dev (e no `vite preview`).
# O navegador nunca vê esse endereço — o front só chama "/api/...".
VITE_API_PROXY_TARGET=http://localhost:8787
# Página de status pública (link do StatusBadge no rodapé). Padrão: https://status.jucasoft.com.br/
VITE_STATUS_PAGE_URL=https://status.jucasoft.com.br/
# Domínio público do site (canonical, sitemap, robots, Open Graph). Padrão: https://ddns.juk.re
VITE_SITE_URL=https://ddns.juk.re
